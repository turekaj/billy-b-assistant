# ============================================================================
# AI Provider Configuration Examples
# Copy the desired configuration to .env and update API keys
# ============================================================================

# ============================================================================
# CONFIGURATION 1: OpenAI Realtime (Default - Recommended)
# ============================================================================
# Real-time interactive conversations with native audio support
# No separate TTS/STT needed
# Best latency and real-time feel
#
# Uncomment these lines:
#AI_PROVIDER=openai_realtime
#OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
#OPENAI_MODEL=gpt-realtime-mini

# ============================================================================
# CONFIGURATION 2: Grok + OpenAI Audio
# ============================================================================
# Uses Grok AI for text processing with OpenAI's TTS/STT
# Good for testing Grok API without replacing speech processing
#
# Uncomment these lines:
#AI_PROVIDER=grok
#GROK_API_KEY=xai-YOUR_KEY_HERE
#GROK_MODEL=grok-2
#TTS_PROVIDER=openai
#STT_PROVIDER=openai
#OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# ============================================================================
# CONFIGURATION 3: Grok + Local Audio (Offline)
# ============================================================================
# Uses Grok AI with local TTS/STT for privacy
# Requires local audio engines (Festival, Vosk, etc.)
#
# Uncomment these lines:
#AI_PROVIDER=grok
#GROK_API_KEY=xai-YOUR_KEY_HERE
#GROK_MODEL=grok-2
#TTS_PROVIDER=local
#STT_PROVIDER=local
#LOCAL_TTS_ENGINE=festival
#LOCAL_STT_ENGINE=vosk

# ============================================================================
# CONFIGURATION 4: OpenAI Realtime + Custom Voice
# ============================================================================
# Same as Configuration 1 but with specific voice selection
# Can be overridden per-persona in persona.ini [PROVIDERS] section
#
# Uncomment these lines:
#AI_PROVIDER=openai_realtime
#OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE
#OPENAI_MODEL=gpt-realtime-mini
# Note: voice is set in persona.ini, default is "ballad"

# ============================================================================
# Audio Processing Configuration (applies to all providers)
# ============================================================================

# Microphone device preference (leave empty to auto-detect)
#MIC_PREFERENCE=Headset Microphone

# Speaker device preference (leave empty to auto-detect)
#SPEAKER_PREFERENCE=Speakers

# Microphone timeout (seconds to wait before stopping recording)
#MIC_TIMEOUT_SECONDS=5

# Audio chunk size for streaming (milliseconds)
#CHUNK_MS=40

# Silence threshold for voice detection
#SILENCE_THRESHOLD=1000

# Turn detection eagerness (low/medium/high)
#TURN_EAGERNESS=high

# ============================================================================
# Other Configuration
# ============================================================================

# Log level
LOG_LEVEL=INFO

# Text-only mode (for debugging without audio)
TEXT_ONLY_MODE=false

# Run mode (normal or dory for single interaction)
RUN_MODE=normal

# Home Assistant integration
HA_TOKEN=
HA_URL=http://homeassistant.local:8123

# MQTT for hardware communication
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

# ============================================================================
# Hardware Configuration
# ============================================================================

# Billy model (classic or modern)
BILLY_MODEL=modern

# GPIO pin configuration (new or legacy)
BILLY_PINS=new

# Mouth articulation intensity (0-10)
MOUTH_ARTICULATION=5

# Playback volume (0.0-1.0, adjusted for audio quality)
# Note: This is hardcoded to 0.3 in code, configurable later
#PLAYBACK_VOLUME=0.3

# ============================================================================
# Testing & Development
# ============================================================================

# Enable test mode (disables GPIO, uses mock classes)
TEST_MODE=false

# Debug logging
DEBUG_MODE=true

# Include audio deltas in debug output
DEBUG_MODE_INCLUDE_DELTA=false
